# ========================================================
# .gitignore für Trains / Father-Son-Model-World
# ========================================================

# --- Abhängigkeiten & Paketmanager ---
node_modules/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# --- IDEs & Editoren ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
*.bak

# --- Betriebssystem & Dateisystem ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.fuse_hidden*

# --- Sensible Daten & Zugangsdaten ---
.env
.env.*
!.env.example
*.token
*.key
*.pem
*.pfx
*.p12
token.txt
.pat_temp
*.credentials

# --- Temporäre Dateien, Logs & Caches ---
*.log
*.tmp
*.temp
*.orig
.push_log
.push_status

# --- Archive & Dumps ---
*.zip
*.tar
*.gz
*.rar
*.7z
*.dmp
*.dump

# --- 3D Software Backups (Blender etc.) ---
*.blend1
*.blend2
*.blend3
*.blend4
*.blend5
*.autosave
